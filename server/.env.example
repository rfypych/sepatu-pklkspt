# Konfigurasi server. Untuk produksi (Vercel) set env berikut di dashboard Vercel.
# DATABASE_URL wajib diisi (Neon connection string, format: postgresql://user:pass@host/db)

# Database (PostgreSQL)
DATABASE_URL=
# PGSSL=false untuk dev lokal tanpa TLS; biarkan kosong (TLS aktif) untuk Neon.
PGSSL=

# Server
PORT=3000

# Offset jam untuk menentukan "tanggal hari ini" (default 7 = WIB).
# Ubah bila pabrik di zona waktu lain (mis. WITA=8, WIT=9).
TZ_OFFSET_HOURS=7

# Auth
JWT_SECRET=sepatu-dev-secret
